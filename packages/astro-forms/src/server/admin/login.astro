---
/**
 * GET /forms-admin/login (ADMN-01) — the admin password login form. Split
 * page/handler: this page only renders; POST /forms-admin/auth (auth.ts)
 * authenticates. No client framework (design spec §5.6) — plain HTML/CSS,
 * server-rendered only.
 *
 * Ships as RAW SOURCE (research packaging pitfall — tsup cannot compile
 * .astro pages); route injection making this reachable is consolidated in
 * P05, which also owns this file's package.json exports-map entry.
 *
 * 0.1.15: the document comes from `renderLoginPageHtml` (admin/_shared.ts),
 * like every other admin page. Its one inline style is the shared admin
 * stylesheet, so `ADMIN_STYLE_HASH` covers this page in a host's own CSP
 * header too. An Astro-processed style block here got a per-build hash
 * that no host could list in advance.
 */
import config from 'virtual:cool-astro-forms/config';
import { ADMIN_STYLE_HASH, adminUrl, renderLoginPageHtml } from './_shared.js';

export const prerender = false;

// Under the host's Astro CSP, allow the admin stylesheet by hash. Only read
// Astro.csp when CSP is on (it warns per request otherwise).
if (config.cspEnabled) Astro.csp?.insertStyleHash(ADMIN_STYLE_HASH);

const actionUrl = adminUrl('/forms-admin/auth', config.trailingSlash);
const hasError = Astro.url.searchParams.get('error') === '1';
const pageHtml = renderLoginPageHtml({ actionUrl, hasError });
---

<Fragment set:html={pageHtml} />
